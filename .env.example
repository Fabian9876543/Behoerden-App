# ---------------------------------------------------------------------------
# BehoerdenBuddy - Environment
# Kopiere diese Datei nach `.env.local` und fuelle die Werte aus.
# `.env.local` gehoert NIEMALS ins Repository.
# ---------------------------------------------------------------------------

# --- Supabase (Projekt-Einstellungen > API) --------------------------------
# Oeffentlich, darf im Client landen.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-Role-Key: NUR serverseitig. Wird fuer Account-Loeschung und
# Storage-Aufraeumarbeiten benoetigt. Niemals mit NEXT_PUBLIC_ praefixen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Claude API ------------------------------------------------------------
# Nur serverseitig. Niemals mit NEXT_PUBLIC_ praefixen.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Modell ueberschreiben (Default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: maximale Uploadgroesse in Bytes (Default 10 MB)
# MAX_UPLOAD_BYTES=10485760
